# ---- Server ----
PORT=8080
HOST=0.0.0.0
DATA_DIR=./data
LOG_LEVEL=info
# Admin UI credentials (HTTP Basic Auth)
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
# Public HTTPS URL of this service (optional). Used for links in review messages and
# for hosting post images; without it previews use the stock provider CDN.
# PUBLIC_BASE_URL=https://fabric.example.com

# ---- OpenAI ----
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-5.1

# ---- Telegram ----
# One bot for all channels; add it as administrator to every channel it posts to.
TELEGRAM_BOT_TOKEN=123456:ABC...
# Your personal chat id with the bot: send /start to the bot to see it.
# When set, drafts arrive here with Publish / Regenerate / Skip buttons.
ADMIN_TELEGRAM_CHAT_ID=

# ---- Max (VK) ---- optional: leave empty to skip Max publishing entirely
MAX_BOT_TOKEN=
MAX_API_BASE_URL=https://platform-api2.max.ru
# Max API uses a certificate from the Russian national CA. Preferred: put the root
# certificate into ./certs/ (see README) — docker-compose sets NODE_EXTRA_CA_CERTS.
# Dev-only fallback that disables TLS verification for Max requests:
MAX_INSECURE_TLS=false

# ---- Images ---- at least one key is recommended; several = automatic fallback
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ---- Scheduler / workers ----
MAX_CONCURRENCY=4
SCHEDULER_TICK_SECONDS=30
# If the service was down, slots older than this are recorded as skipped instead of fired late
MISFIRE_GRACE_MINUTES=30
SCHEDULER_DISABLED=false
